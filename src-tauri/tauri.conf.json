{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "QuotaHUD",
  "version": "0.0.0",
  "identifier": "dev.quotahud.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "QuotaHUD",
        "width": 380,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "QuotaHUD Settings",
        "width": 720,
        "height": 840,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/butaosuinu/ai-limit-quota-hud/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
