{
  "name": "quotahud",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm i18n:compile && vite",
    "build": "pnpm i18n:compile && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "pnpm i18n:compile && oxlint src/ && eslint . --ignore-pattern \"src-tauri/**\" --ignore-pattern \".dmux/**\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm i18n:compile && tsc --noEmit",
    "precheck": "pnpm typecheck && pnpm lint && pnpm format:check",
    "pretest": "pnpm i18n:compile",
    "pretest:watch": "pnpm i18n:compile",
    "pretest:coverage": "pnpm i18n:compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rs:coverage": "cargo +nightly llvm-cov --manifest-path src-tauri/Cargo.toml --workspace --branch --text --output-dir coverage-rs",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "jotai": "^2.10.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/conf": "^5.9.5",
    "@lingui/macro": "^5.9.5",
    "@lingui/vite-plugin": "^5.9.5",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "babel-plugin-macros": "^3.1.0",
    "eslint": "^9.25.0",
    "eslint-config-love": "^151.0.0",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
