node_modules/
dist/
dist-ssr/
.vite/

# Coverage reports (generated by `pnpm test:coverage` / `cargo llvm-cov`)
coverage/
coverage-rs/

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# OS / editor noise
.DS_Store
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/extensions.json
.dmux/
.codex/

# Lingui コンパイル成果物 (po は git 管理、ts は自動生成のため除外)
src/locales/**/messages.ts
src/locales/**/messages.d.ts

# Claude Code: ローカル上書き設定のみ ignore。settings.json と hooks/ は共有する。
.claude/settings.local.json
# dmux pane 固有のローカル artifact (hooks / pane lock / runtime メタデータ)。
# `dmux` CLI が worktree ごとに絶対パスで書き出すため共有してはいけない。
.claude/dmux/
.claude/hooks/dmux-*.cjs
.claude/scheduled_tasks.lock

# global gitignore に "Icon" (macOS Finder custom icon) ルールがあり、case-insensitive FS で
# tools/icon/ ディレクトリ全体が誤って ignore されるため明示的に un-ignore する。
!tools/icon/
!tools/icon/**
