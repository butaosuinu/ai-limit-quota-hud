{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "pnpm-lock.yaml",
    "src-tauri/target/",
    "src-tauri/gen/",
    "src/locales/**/messages.ts",
    "src/locales/**/messages.d.ts",
    ".claude/",
    ".mcp.json"
  ]
}
